---
interface Props {
	/**
	 * The text content of the button
	 */
	text: string;

	/**
	 * Optional URL if the button should be rendered as a link
	 */
	href?: string;

	/**
	 * Button type (only applies when not a link)
	 * @default "button"
	 */
	type?: "button" | "submit" | "reset";

	/**
	 * Visual style variant
	 * @default "primary"
	 */
	variant?: "primary" | "secondary" | "ghost" | "danger";

	/**
	 * Width style of the button
	 * @default "auto"
	 */
	width?: "auto" | "full";

	/**
	 * Size of the button
	 * @default "medium"
	 */
	size?: "small" | "medium" | "large";

	/**
	 * Optional icon name (using your icon system)
	 */
	icon?: string;

	/**
	 * Position of the icon relative to text
	 * @default "left"
	 */
	iconPosition?: "left" | "right";

	/**
	 * Whether the button is disabled
	 * @default false
	 */
	disabled?: boolean;

	/**
	 * Animation style
	 * @default "none"
	 */
	animation?: "none" | "moema";

	/**
	 * Whether to use inverted colors for the animation
	 * @default false
	 */
	inverted?: boolean;

	/**
	 * Optional CSS class to add to the button
	 */
	class?: string;

	/**
	 * Optional aria-label for accessibility
	 */
	ariaLabel?: string;
}

const {
	text,
	href,
	type = "button",
	variant = "primary",
	width = "auto",
	size = "medium",
	icon,
	iconPosition = "left",
	disabled = false,
	animation = "none",
	inverted = false,
	class: className = "",
	ariaLabel,
} = Astro.props;

// Determine if this is a link or button
const Element = href ? "a" : "button";

// Prepare attributes based on element type
const attributes = href
	? { href: disabled ? undefined : href }
	: { type, disabled };

// Additional accessibility attributes
const a11yAttrs = ariaLabel ? { "aria-label": ariaLabel } : {};
---

<Element
	{...attributes}
	{...a11yAttrs}
	data-variant={variant}
	data-width={width}
	data-size={size}
	data-icon={icon ? "true" : null}
	data-icon-position={icon ? iconPosition : null}
	data-disabled={disabled ? "true" : null}
	data-animation={animation}
	data-inverted={inverted ? "true" : null}
	class={className}
>
	{
		icon && iconPosition === "left" && (
			<span class='icon'>
				<i class={`icon-${icon}`} />
			</span>
		)
	}

	<span class='text'>{text}</span>

	{
		icon && iconPosition === "right" && (
			<span class='icon'>
				<i class={`icon-${icon}`} />
			</span>
		)
	}

	<slot />
</Element>

<style>
	/* Base button styles */
	button,
	a {
		display: inline-flex;
		align-items: center;
		justify-content: center;
		gap: 0.5rem;
		font-family: inherit;
		font-weight: 500;
		text-decoration: none;
		border: none;
		border-radius: 0.375rem;
		cursor: pointer;
		transition: all 0.2s ease-in-out;
		position: relative;
		z-index: 1;
		overflow: hidden;
	}

	/* Width variants */
	[data-width="auto"] {
		width: auto;
	}

	[data-width="full"] {
		width: 100%;
	}

	/* Size variants */
	[data-size="small"] {
		padding: 0.5rem 1rem;
		font-size: 0.875rem;
	}

	[data-size="medium"] {
		padding: 0.75rem 1.5rem;
		font-size: 1rem;
	}

	[data-size="large"] {
		padding: 1rem 2rem;
		font-size: 1.125rem;
	}

	/* Color variants */
	[data-variant="primary"] {
		background-color: var(--color-primary, #4f46e5);
		color: white;
	}

	[data-variant="primary"]:hover:not([data-disabled="true"]):not(
			[data-animation="moema"]
		) {
		background-color: var(--color-primary-dark, #4338ca);
	}

	[data-variant="secondary"] {
		background-color: var(--color-secondary, #f3f4f6);
		color: var(--color-text, #111827);
		border: 1px solid var(--color-border, #d1d5db);
	}

	[data-variant="secondary"]:hover:not([data-disabled="true"]):not(
			[data-animation="moema"]
		) {
		background-color: var(--color-secondary-dark, #e5e7eb);
	}

	[data-variant="ghost"] {
		background-color: transparent;
		color: var(--color-primary, #4f46e5);
	}

	[data-variant="ghost"]:hover:not([data-disabled="true"]):not(
			[data-animation="moema"]
		) {
		background-color: var(--color-ghost-hover, rgba(79, 70, 229, 0.1));
	}

	[data-variant="danger"] {
		background-color: var(--color-danger, #ef4444);
		color: white;
	}

	[data-variant="danger"]:hover:not([data-disabled="true"]):not(
			[data-animation="moema"]
		) {
		background-color: var(--color-danger-dark, #dc2626);
	}

	/* Icon styling */
	.icon {
		display: inline-flex;
		align-items: center;
		justify-content: center;
	}

	/* Space adjustments for icon position */
	[data-icon-position="left"] .text {
		order: 2;
	}

	[data-icon-position="left"] .icon {
		order: 1;
	}

	[data-icon-position="right"] .text {
		order: 1;
	}

	[data-icon-position="right"] .icon {
		order: 2;
	}

	/* Disabled state */
	[data-disabled="true"] {
		opacity: 0.5;
		cursor: not-allowed;
		pointer-events: none;
	}

	/* Moema Animation Styles */
	[data-animation="moema"] {
		border-radius: 50px;
		transition:
			background-color 0.3s,
			color 0.3s;
	}

	/* Default Moema colors if no variant is specified */
	[data-animation="moema"] {
		background: var(--moema-bg, #7986cb);
		color: var(--moema-color, #fff);
	}

	/* Moema with primary variant */
	[data-animation="moema"][data-variant="primary"] {
		background: var(--color-primary, #4f46e5);
		color: white;
	}

	/* Moema with secondary variant */
	[data-animation="moema"][data-variant="secondary"] {
		background: var(--color-secondary, #f3f4f6);
		color: var(--color-text, #111827);
	}

	/* Moema with ghost variant */
	[data-animation="moema"][data-variant="ghost"] {
		background: transparent;
		color: var(--color-primary, #4f46e5);
	}

	/* Moema with danger variant */
	[data-animation="moema"][data-variant="danger"] {
		background: var(--color-danger, #ef4444);
		color: white;
	}

	/* Inverted Moema */
	[data-animation="moema"][data-inverted="true"] {
		background: var(--moema-inverted-bg, #eceff1);
		color: var(--moema-inverted-color, #37474f);
	}

	/* Pseudo-element for animation */
	[data-animation="moema"]::before {
		content: "";
		position: absolute;
		top: -20px;
		left: -20px;
		bottom: -20px;
		right: -20px;
		background: inherit;
		border-radius: 50px;
		z-index: -1;
		opacity: 0.4;
		transform: scale3d(0.8, 0.5, 1);
	}

	/* Hover effects for Moema */
	[data-animation="moema"]:hover:not([data-disabled="true"]) {
		transition:
			background-color 0.1s 0.3s,
			color 0.1s 0.3s;
		color: var(--moema-hover-color, #eceff1);
		background-color: var(--moema-hover-bg, #3f51b5);
		animation: anim-moema-1 0.3s forwards;
	}

	/* Hover for primary variant */
	[data-animation="moema"][data-variant="primary"]:hover:not(
			[data-disabled="true"]
		) {
		color: white;
		background-color: var(--color-primary-dark, #4338ca);
	}

	/* Hover for secondary variant */
	[data-animation="moema"][data-variant="secondary"]:hover:not(
			[data-disabled="true"]
		) {
		color: var(--color-text, #111827);
		background-color: var(--color-secondary-dark, #e5e7eb);
	}

	/* Hover for ghost variant */
	[data-animation="moema"][data-variant="ghost"]:hover:not(
			[data-disabled="true"]
		) {
		color: var(--color-primary, #4f46e5);
		background-color: var(--color-ghost-hover, rgba(79, 70, 229, 0.1));
	}

	/* Hover for danger variant */
	[data-animation="moema"][data-variant="danger"]:hover:not(
			[data-disabled="true"]
		) {
		color: white;
		background-color: var(--color-danger-dark, #dc2626);
	}

	/* Hover for inverted Moema */
	[data-animation="moema"][data-inverted="true"]:hover:not(
			[data-disabled="true"]
		) {
		color: var(--moema-inverted-hover-color, #eceff1);
		background-color: var(--moema-inverted-hover-bg, #7986cb);
	}

	/* Animation for the pseudo-element */
	[data-animation="moema"]:hover::before {
		animation: anim-moema-2 0.3s 0.3s forwards;
	}

	/* Keyframes for the button scale animation */
	@keyframes anim-moema-1 {
		60% {
			transform: scale3d(0.8, 0.8, 1);
		}
		85% {
			transform: scale3d(1.1, 1.1, 1);
		}
		100% {
			transform: scale3d(1, 1, 1);
		}
	}

	/* Keyframes for the ripple effect */
	@keyframes anim-moema-2 {
		to {
			opacity: 0;
			transform: scale3d(1, 1, 1);
		}
	}
</style>
