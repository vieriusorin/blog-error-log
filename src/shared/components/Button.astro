---
interface Props {
	/**
	 * The text content of the button
	 */
	text: string;

	/**
	 * Optional URL if the button should be rendered as a link
	 */
	href?: string;

	/**
	 * Button type (only applies when not a link)
	 * @default "button"
	 */
	type?: "button" | "submit" | "reset";

	/**
	 * Visual style variant
	 * @default "primary"
	 */
	variant?: "primary" | "secondary" | "ghost" | "danger";

	/**
	 * Width style of the button
	 * @default "auto"
	 */
	width?: "auto" | "full";

	/**
	 * Size of the button
	 * @default "medium"
	 */
	size?: "small" | "medium" | "large";

	/**
	 * Optional icon name (using your icon system)
	 */
	icon?: string;

	/**
	 * Position of the icon relative to text
	 * @default "left"
	 */
	iconPosition?: "left" | "right";

	/**
	 * Whether the button is disabled
	 * @default false
	 */
	disabled?: boolean;

	/**
	 * Optional CSS class to add to the button
	 */
	class?: string;

	/**
	 * Optional aria-label for accessibility
	 */
	ariaLabel?: string;
}

const {
	text,
	href,
	type = "button",
	variant = "primary",
	width = "auto",
	size = "medium",
	icon,
	iconPosition = "left",
	disabled = false,
	class: className = "",
	ariaLabel,
} = Astro.props;

// Determine if this is a link or button
const Element = href ? "a" : "button";

// Prepare attributes based on element type
const attributes = href
	? { href: disabled ? undefined : href }
	: { type, disabled };

// Additional accessibility attributes
const a11yAttrs = ariaLabel ? { "aria-label": ariaLabel } : {};
---

<Element
	{...attributes}
	{...a11yAttrs}
	data-variant={variant}
	data-width={width}
	data-size={size}
	data-icon={icon ? "true" : null}
	data-icon-position={icon ? iconPosition : null}
	data-disabled={disabled ? "true" : null}
	class={className}
>
	{
		icon && iconPosition === "left" && (
			<span class='icon'>
				<i class={`icon-${icon}`} />
			</span>
		)
	}
	{text}
	{
		icon && iconPosition === "right" && (
			<span class='icon'>
				<i class={`icon-${icon}`} />
			</span>
		)
	}

	<slot />
</Element>

<style>
	/* Base button styles - Using CDS Tokens */
	button,
	a {
		display: grid;
		padding: var(--cds-spacing-lg) var(--cds-spacing-lg);
		align-items: center;
		border-radius: var(--cds-borderRadius-full);
		justify-content: center;
		gap: var(--cds-space-xs); /* Use space token */
		font-family: var(--cds-typography-fontFamily-sans);
		font-weight: var(--cds-typography-fontWeight-regular);
		letter-spacing: var(--cds-typography-letterSpacing-wide);
		text-decoration: none;
		border: none;
		cursor: pointer;
		transition:
			background-color 0.2s ease-in-out,
			color 0.2s ease-in-out,
			border-color 0.2s ease-in-out;
		z-index: 1;
		text-transform: lowercase;

		&::first-letter {
			text-transform: uppercase;
		}
	}

	/* Width variants */
	[data-width="auto"] {
		width: auto;
	}

	[data-width="full"] {
		width: 100%;
	}

	/* Size variants - Using CDS Tokens */
	[data-size="small"] {
		padding: var(--cds-spacing-xs) var(--cds-spacing-sm);
		font-size: var(--cds-typography-fontSize-sm);
	}

	[data-size="medium"] {
		padding: var(--cds-spacing-md) var(--cds-spacing-lg);
		font-size: var(--cds-typography-fontSize-base);
	}

	[data-size="large"] {
		padding: var(--cds-spacing-base) var(--cds-spacing-lg);
		font-size: var(--cds-typography-fontSize-lg);
	}

	/* Color variants - Using CDS Tokens */
	/* Base Variant Styles */
	[data-variant="primary"] {
		color: var(--cds-color-white);
		background-color: var(--cds-color-primary-base);
	}

	[data-variant="secondary"] {
		background-color: var(--cds-color-secondary-base);
		color: var(--cds-color-gray-900); /* Dark text for light secondary button */
		/* Add border using cds tokens - assuming default theme is light */
		/* border: 1px solid var(--cds-color-gray-300); */
		/* OR using the secondary color itself if appropriate */
		border: 1px solid var(--cds-color-secondary-dark);
	}
	[data-variant="ghost"] {
		background-color: transparent;
		color: var(--cds-color-primary-base);
	}
	/* Mapping danger button variant to tertiary role */
	[data-variant="danger"] {
		background-color: var(--cds-color-tertiary-base);
		color: var(--cds-color-white); /* Assuming white text on this bg */
	}

	/* Hover States (excluding disabled) */
	[data-variant="primary"]:hover:not([data-disabled="true"]) {
		background-color: var(--cds-color-primary-hover);
	}
	[data-variant="secondary"]:hover:not([data-disabled="true"]) {
		background-color: var(--cds-color-secondary-hover);
		border-color: var(--cds-color-secondary-hover);
	}
	[data-variant="ghost"]:hover:not([data-disabled="true"]) {
		background-color: var(
			--cds-color-primary-light
		); /* Use light primary for hover bg */
		color: var(--cds-color-primary-dark); /* Darken text slightly */
	}
	[data-variant="danger"]:hover:not([data-disabled="true"]) {
		background-color: var(--cds-color-tertiary-hover);
	}

	/* Focus States - Add distinct focus styles using CDS tokens */
	button:focus-visible,
	a:focus-visible {
		outline: 2px solid var(--cds-color-primary-focus); /* Example: Using primary focus color */
		outline-offset: 2px;
	}
	/* Optional: Variant-specific focus (e.g., danger uses tertiary focus) */
	[data-variant="danger"]:focus-visible {
		outline-color: var(--cds-color-tertiary-focus);
	}
	[data-variant="secondary"]:focus-visible {
		outline-color: var(--cds-color-secondary-focus);
	}
	/* etc. */

	/* Icon styling */
	.icon {
		display: inline-flex;
		align-items: center;
		justify-content: center;
	}

	/* Space adjustments for icon position */
	[data-icon-position="left"] .text {
		order: 2;
	}

	[data-icon-position="left"] .icon {
		order: 1;
	}

	[data-icon-position="right"] .text {
		order: 1;
	}

	[data-icon-position="right"] .icon {
		order: 2;
	}

	/* Disabled state */
	[data-disabled="true"] {
		opacity: 0.6; /* Adjusted opacity */
		cursor: not-allowed;
		pointer-events: none; /* Keep pointer-events */
	}
</style>
