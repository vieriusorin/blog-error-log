---
import { getCollection } from "astro:content";
import RootLayout from "../../shared/layouts/RootLayout.astro";

const posts = (await getCollection("essentials")).sort(
	(a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf()
);
---

<RootLayout title='Essentials' description='Essentials description'>
	<section>
		<ul>
			{
				posts.map((post) => (
					<li>
						<a href={`/essentials/${post.id}/`}>
							<h4 class='title'>{post.data.title}</h4>
							{/* <p class="date">
										<FormattedDate date={post.data?.pubDate} />
									</p> */}
						</a>
					</li>
				))
			}
		</ul>
	</section>
</RootLayout>
