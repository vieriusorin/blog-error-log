---
import { type CollectionEntry, getCollection } from 'astro:content';
import { render } from 'astro:content';
import EssentialPost from '../../layouts/EssentialPost.astro';

export async function getStaticPaths() {
	const posts = await getCollection('essentials');
	return posts.map((post) => ({
		params: { slug: post.id },
		props: post,
	}));
}
type Props = CollectionEntry<'essentials'>;

const post = Astro.props;
const { Content } = await render(post);
---

<EssentialPost {...post.data}>
	<Content />
</EssentialPost>
